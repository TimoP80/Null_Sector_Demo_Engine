// ===========================================================================
// NULL SECTOR // GHOST IN THE MACHINE
// data/demo.nsd - the whole show, scripted. Nothing below touches the engine:
// scenes, cameras, effects, animations, post presets and assets are all data.
//
//   demo { bpm 216; duration 125 }         header (bars are 4 beats @ bpm)
//   scene Name { bars N; camera ...; show effect; at t { ... } }
//   at t { cmd ... }                       absolute-time events
//
// Commands: show/hide, load (shadertoy|model|material|plugin|effect),
//   shader FILE, camera NAME { rig ... }, play, fade in|out, transition,
//   post (preset NAME | legacy | { key v }), anim, marker, speed, loop,
//   jump, and scene-graph nodes: mesh/sprite/text/light/particles/empty.
//
// Times accept seconds, mm:ss, or bar/beat units (e.g. "bar 4", "24 beat").
// Live reload: edit demo.nsd (or any shader/asset below) and it reloads
// without restarting.
// ===========================================================================
demo "GHOST IN THE MACHINE" {
    bpm 216
    duration 125
}

// ---------------------------------------------------------------------------
// SCENE 0 // Awakening (0:00)
// ---------------------------------------------------------------------------
scene Intro {
    bars 12  intensity 0.12  chapter 0
    title "Awakening"
    camera IntroCam { rig drift; pos (0,0,2.4); fov (50,58); amp 1.6; freq 0.14; handheld (0.04,0.3) }
    show intro
    play music
    fade in 2
    at 4 { anim introBloom post.bloom smooth { 0 1.2; 3 2.4; 6 1.5 } }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 1 // The Nave (0:13.3) - gliding descent through the cathedral
// ---------------------------------------------------------------------------
scene Cathedral {
    bars 12  intensity 0.55  chapter 1
    title "The Nave"
    camera NaveCam { rig nave; pos (0,6.5,18); target (0,5.5,0); speed 6.2; fov 58; sway (2.5,1.0,0); freq 0.21; handheld 0.05; dofFocus 12; dofAperture 0.03 }
    show cathedral
    post legacy
    at 4 { anim pillGlow effect:cathedral.uniform:uMode smooth { 0 0; 3 0.6; 6 0 } }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 2 // Synapse (0:26.7) - orbit inside the network, preset post stack
// ---------------------------------------------------------------------------
scene Neuralnet {
    bars 12  intensity 0.62  chapter 2
    title "Synapse"
    camera NetCam { rig orbit; pos (0,1.5,0); target (0,0.8,0); radius 4.5; omega 0.45; fov 64; sway (0,1.8,0); handheld 0.08; dofFocus 5; dofAperture 0.06 }
    show neuralnet
    post preset cinematic
    at 2 { anim netExposure post.exposure smooth { 0 0.9; 5 1.15; 10 1.0 } }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 3 // The Infinite Machine (0:40) - forward flight, uniform animation
// ---------------------------------------------------------------------------
scene Machine {
    bars 12  intensity 0.68  chapter 2
    title "The Infinite Machine"
    camera MachineCam { rig fly; pos (0,0,14); speed 6.5; fov 62; sway (1.2,0.9,0); freq 0.33; handheld 0.08; dofFocus 8; dofAperture 0.05 }
    show infinitemachine
    post legacy
    at 4 { anim machineMode effect:infinitemachine.uniform:uMode smooth { 0 0; 3 1; 7 0 } }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 4 // Downtown (0:53.3) - voxel city flyover, VHS-grade post
// ---------------------------------------------------------------------------
scene Voxel {
    bars 10  intensity 0.88  chapter 3
    title "Downtown"
    camera CityCam { rig city; pos (0,20,30); target (0,8,0); speed 5; fov 62; sway (6,3,0); freq 0.09; handheld 0.07; dofFocus 14; dofAperture 0.04 }
    show voxel
    post preset vhs
    at 9 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 5 // Imported (1:04.4) - the Shadertoy importer, two samples
// ---------------------------------------------------------------------------
scene Shadertoy {
    bars 12  intensity 0.5  chapter 2
    title "Imported"
    camera ShaderCam { rig static; pos (0,0,1.4); target (0,0,0); fov 60 }
    load shadertoy plasma.glsl
    show shadertoy:plasma.glsl
    at 6 { load shadertoy tunnel_warp.glsl; show shadertoy:tunnel_warp.glsl }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 6 // Asset Pipeline (1:17.8) - scene graph, 3D models, PBR materials,
//         sprites, text, keyframed camera + node animations
// ---------------------------------------------------------------------------
scene Model {
    bars 10  intensity 0.5  chapter 2
    title "Asset Pipeline"
    camera Reticle { rig static; pos (0,1.2,7); target (0,0.5,0); fov 52 }
    shader dataviz_bg.frag
    post preset clean
    load material chrome
    load material neon
    load model terrain.obj
    load model gem.obj
    mesh terrain { model terrain.obj; material chrome; pos (0,-0.5,0) }
    mesh gem { model gem.obj; material neon; pos (2.2,1.4,0); scale (0.8,0.8,0.8) }
    light sun { type directional; color (1,0.92,0.78); intensity 2.0 }
    light fill { type point; color (0.4,0.6,1); intensity 6; range 14 }
    sprite halo { tex ghost_logo.png; pos (0,1.9,-4); size (5,2.5,1); opacity 0.55 }
    text caption { text "3D // PBR // OBJ IMPORT"; pos (0,0.55,0); size 26; style neon }
    at 1 { anim camOrbit camera.pos smooth { 0 (0,1.2,7); 4 (2.4,1.6,5); 8 (0,2.0,3.4); 10 (-2.4,1.6,5); 12 (0,1.2,7) } }
    at 1 { anim gemSpin node:gem.euler linear { 0 (0,0,0); 9 (0,360,0) } }
    at 1 { anim gridBob node:terrain.pos bounce { 0 (0,-0.5,0); 4 (0,-0.35,0); 8 (0,-0.5,0) } }
    at 1 { anim captionFade node:caption.opacity elastic { 0 0; 2 1; 8 1 } }
    at 9 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 7 // Formation (1:28.9) - the ghost assembles from particles
// ---------------------------------------------------------------------------
scene Ghost {
    bars 12  intensity 0.72  chapter 3
    title "Formation"
    camera GhostCam { rig hover; pos (0,1.5,3.6); target (0,1.55,0); fov 52; sway (0.5,0.16,0); freq 0.12; handheld 0.03; dofFocus 3.4; dofAperture 0.02 }
    show ghostformation
    post legacy
    at 2 { anim ghostSwell post.bloom smooth { 0 2.2; 5 3.4; 10 2.4 } }
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 8 // Reprise (1:42.2) - the tunnel returns, morphing
// ---------------------------------------------------------------------------
scene Tunnel {
    bars 12  intensity 0.45  chapter 1
    title "Reprise"
    camera TubeCam { rig fly; pos (0,0,14); speed 22; fov 64; sway (0,0,0); freq 0.2; handheld 0.06; dofFocus 9; dofAperture 0.05 }
    show tunnel { mode 1 }
    post legacy
    at 11 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 9 // Sign-Off (1:55.6) - the greeting card, then fade to black + loop
// ---------------------------------------------------------------------------
scene Greetings {
    bars 8  intensity 0.3  chapter 5
    title "Sign-Off"
    camera PosterCam { rig static; pos (0,0,2); target (0,0,0); fov 55 }
    show greetings { mode 0 }
    fade in 1
    at 6 { fade out 2 }
}

// ---------------------------------------------------------------------------
// The show: one activation per scene. Section boundaries + the timeline
// schedule derive from these exact times.
// ---------------------------------------------------------------------------
at 0    { show Intro; marker Awakening }
at 13.3 { show Cathedral; marker Nave }
at 26.7 { show Neuralnet; marker Synapse }
at 40   { show Machine; marker Machine }
at 53.3 { show Voxel; marker Downtown }
at 64.4 { show Shadertoy; marker Imported }
at 77.8 { show Model; marker Pipeline }
at 88.9 { show Ghost; marker Formation }
at 102.2 { show Tunnel; marker Reprise }
at 115.6 { show Greetings; marker SignOff }

// ---------------------------------------------------------------------------
