// ===========================================================================
// NULL SECTOR // NEURAL DUST
// data/neural_dust.nsd - the whole show, scripted. Nothing below touches the
// engine: scenes, cameras, effects, animations, post presets and the section
// schedule are all data. The audio is data/neural_dust/track.wav (128 BPM,
// generated by tools/gen_neural_dust_track.py) - run with:
//
//   ns_demo --demo=data/neural_dust.nsd --track=data/neural_dust/track.wav
//
// Concept: an AI attempts to reconstruct a vanished reality from corrupted
// memory. BOOT -> CORE -> TUNNEL -> CITY -> CORRUPTION -> DREAM -> OCEAN ->
// SYSTEM FAILURE -> FINAL RECONSTRUCTION -> NEW REALITY. The show runs the
// full 185 bars @ 128 BPM = 5:47 (346.77s) of the soundtrack - the epilogue
// carries the track's outro instead of looping at 4:32.
//
// All musical response lives in the shaders (react.kick/bass/mid/high/
// energy/beat/bar via uFlash/uBass/uMid/uHigh/uVolume/uPulse + the NullBlock
// clock + musicHue per-bar palette) - this script owns structure, cameras,
// transitions and post, nothing is keyframed beat-by-beat here.
// ===========================================================================
demo "NEURAL DUST" {
    bpm 128
    duration 347
}

// ---------------------------------------------------------------------------
// SCENE 1 // BOOT / MEMORY RECOVERY (0:00, 13 bars)
// Black -> sparse diagnostics -> a wireframe environment assembles.
// ---------------------------------------------------------------------------
scene Boot {
    bars 13  intensity 0.15  chapter 0
    title "Memory Recovery"
    camera BootCam { rig drift; pos (0,0,6); target (0,0,0); fov (50,58); amp 0.8; freq 0.11; handheld 0.02 }
    show ndboot { renderScale 0.52 }
    post preset nd_boot
    fade in 3
    at 23.5 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 2 // MEMORY CORE (0:24, 16 bars)
// The fragmented geometry condenses into a spherical neural network; the
// camera approaches the core and flies through it.
// ---------------------------------------------------------------------------
scene Core {
    bars 16  intensity 0.55  chapter 1
    title "Memory Core"
    camera CoreCam { rig drift; pos (0,0,13); target (0,0,0); fov 58; amp 0.5; freq 0.09; handheld 0.02 }
    show ndcore { renderScale 0.6 }
    post preset nd_core
    at 1 { anim coreFly camera.pos cubic { 0 (0,1,13); 8 (0,0,7); 16 (0,0,0); 24 (0,0,-8); 29 (0,-1,-13) } }
    at 1 { anim coreFov camera.fov linear { 0 58; 16 64; 29 52 } }
    at 29 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 3 // PROCEDURAL MEMORY TUNNEL (0:54, 16 bars)
// Fast forward flight through walls made of fragmented memories.
// ---------------------------------------------------------------------------
scene Tunnel {
    bars 16  intensity 0.7  chapter 1
    title "Memory Tunnel"
    camera TubeCam { rig fly; pos (0,0,14); speed 22; fov 64; sway (1.2,0.9,0); freq 0.24; handheld 0.05 }
    show ndtunnel { renderScale 0.75 }
    post preset nd_tunnel
    at 15 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 4 // LOST CITY (1:24, 18 bars)
// The tunnel opens into a believable abandoned futuristic city.
// ---------------------------------------------------------------------------
scene City {
    bars 18  intensity 0.65  chapter 2
    title "Lost City"
    camera CityCam { rig city; pos (0,24,38); target (0,10,0); speed 4; fov 58; sway (4,2,0); freq 0.08; handheld 0.03 }
    show ndcity { renderScale 0.75 }
    post preset nd_city
    at 17 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 5 // MEMORY CORRUPTION (1:58, 16 bars)
// The city begins to rot; diagnostics flash; the city dissolves to particles.
// ---------------------------------------------------------------------------
scene Corrupt {
    bars 16  intensity 0.85  chapter 3
    title "Memory Corruption"
    camera CorrCam { rig descend; pos (0,20,22); target (0,6,0); speed 2.5; fov 60; descendRate 0.35; handheld 0.1 }
    show ndcorrupt { renderScale 0.75 }
    post preset nd_corrupt
    at 6 { anim corrFov camera.fov linear { 0 60; 24 76 } }
    at 15 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 6 // THE DREAM (2:28, 24 bars)
// A surreal invented world: dark ocean, floating islands, translucent
// structures, a glowing sun. Calm - a world being created, not remembered.
// ---------------------------------------------------------------------------
scene Dream {
    bars 24  intensity 0.35  chapter 4
    title "The Dream"
    camera DreamCam { rig drift; pos (0,2.5,9); target (0,1.5,0); fov 55; amp 1.1; freq 0.09; handheld 0.015 }
    show nddream { renderScale 0.75 }
    post preset nd_dream
    at 2 { anim dreamGlide camera.pos cubic { 0 (0,2.5,9); 16 (6,2.2,2); 32 (-4,1.8,6); 43 (0,2.0,-4) } }
    at 43 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 7 // NEURAL OCEAN (3:13, 16 bars)
// The dream dissolves into a particle ocean; the camera dives beneath the
// surface, which is revealed to be another enormous neural network.
// ---------------------------------------------------------------------------
scene Ocean {
    bars 16  intensity 0.6  chapter 4
    title "Neural Ocean"
    camera OceanCam { rig descend; pos (0,9,0); target (0,0,0); fov 60; descendRate 0.55; handheld 0.02 }
    show ndocean { count 60000 }
    post preset nd_ocean
    // dive continues; at bar 8 the network beneath is revealed
    at 15 { show ndnet { renderScale 0.6 } }
    at 15.3 { camera NetCam { rig descend; pos (0,-4,0); target (0,0,0); fov 64; descendRate 0.12; handheld 0.03 } }
    at 29 { transition fade 1 }
}

// ---------------------------------------------------------------------------
// SCENE 8 // SYSTEM FAILURE (3:43, 16 bars)
// Rapid revisits of every environment, each more corrupted, driving to the
// musical climax - then everything cuts to black.
// ---------------------------------------------------------------------------
scene Failure {
    bars 16  intensity 1.0  chapter 5
    title "System Failure"
    post preset nd_failure
    camera FailCore { rig fly; pos (0,0,12); speed 34; fov 70; sway (3,2,0); freq 0.7; handheld 0.28 }
    at 0 { show ndcore { mode 1; renderScale 0.5 }; marker CoreRecall }
    at 2.2 { camera FailTunnel { rig fly; pos (0,0,14); speed 30; fov 72; sway (2,2.4,0); freq 0.9; handheld 0.3 }; show ndtunnel { mode 1; renderScale 0.75 } }
    at 4.6 { camera FailCity { rig city; pos (0,26,30); target (0,8,0); speed 16; fov 72; sway (8,4,0); freq 0.6; handheld 0.32 }; show ndcorrupt { mode 1; renderScale 0.75 } }
    at 7.0 { camera FailDream { rig drift; pos (0,4,8); target (0,2,0); fov 70; amp 3.0; freq 0.5; handheld 0.3 }; show nddream { mode 1; renderScale 0.75 } }
    at 9.4 { camera FailOcean { rig descend; pos (0,6,0); target (0,0,0); fov 70; descendRate 2.2; handheld 0.35 }; show ndocean { mode 1; count 60000 } }
    at 11.8 { camera FailCore2 { rig fly; pos (0,0,10); speed 42; fov 74; sway (4,3,0); freq 1.0; handheld 0.35 }; show ndcore { mode 1; renderScale 0.5 } }
    at 14.2 { camera FailCity2 { rig city; pos (0,20,24); target (0,4,0); speed 22; fov 76; sway (10,6,0); freq 1.0; handheld 0.4 }; show ndcorrupt { mode 1; renderScale 0.75 } }
    at 16.6 { camera FailDream2 { rig drift; pos (0,3,6); target (0,0,0); fov 74; amp 4.0; freq 0.8; handheld 0.4 }; show nddream { mode 1; renderScale 0.75 } }
    at 18.8 { camera FailNet { rig descend; pos (0,-2,0); target (0,0,0); fov 76; descendRate 3.0; handheld 0.45 }; show ndnet { mode 1; renderScale 0.6 } }
    // climax: everything at once, then an abrupt cut to black
    at 25.5 { show ndcorrupt { mode 1; renderScale 0.75 } }
    at 28.0 { hide ndcorrupt; fade out 0.4 }
}

// ---------------------------------------------------------------------------
// SCENE 9 // FINAL RECONSTRUCTION (4:13, 10 bars)
// Silence. One particle. Thousands reconstruct the NULL SECTOR wordmark.
// CREATING NEW REALITY... then the impact and black.
// ---------------------------------------------------------------------------
scene Final {
    bars 10  intensity 0.15  chapter 5
    title "Final Reconstruction"
    camera FinalCam { rig drift; pos (0,0,2); target (0,0,0); fov 55; amp 0.4; freq 0.08; handheld 0.01 }
    show ndlogo
    post preset nd_final
    fade in 2
    at 17 { fade out 2 }
}

// ---------------------------------------------------------------------------
// SCENE 10 // NEW REALITY (4:32, 40 bars - the track's outro)
// The world the AI created. The track keeps driving past the finale, so the
// epilogue rides its real structure: a rise through the new dream world while
// the drive continues (bars 145-154), a dive through the serene neural sea in
// the breakdown (bars 154-167), a return to the sun as the drive comes back
// (bars 167-178), then the world dissolves to black with the music's
// fade-out (bars 178-185). No loop at 4:32 - the show runs the full track.
// ---------------------------------------------------------------------------
scene NewReality {
    bars 40  intensity 0.4  chapter 5
    title "New Reality"
    camera NewDream { rig drift; pos (0,2.5,10); target (0,2,0); fov 55; amp 0.8; freq 0.09; handheld 0.015 }
    show nddream { renderScale 0.75 }
    post preset nd_dream
    fade in 3
    // act 1: rise through the new world (bars 145-154, the drive)
    at 0.5 { anim newWorldRise camera.pos cubic { 0 (0,2.5,10); 8 (0,3.5,4); 16 (0,4,1) } }
    at 0.5 { anim newWorldFov camera.fov linear { 0 55; 16 62 } }
    // act 2: the serene neural sea (bars 154-167, the breakdown)
    at 16.25 { transition fade 1 }
    at 16.875 { camera NewSea { rig descend; pos (0,5,0); target (0,0,0); fov 62; descendRate 0.3; handheld 0.02 }; show ndocean { count 60000 }; post preset nd_ocean }
    // act 3: dawn - back to the dream, up to the sun (bars 167-178, drive returns)
    at 40.625 { transition fade 1 }
    at 41.25 { camera NewDawn { rig drift; pos (0,5,-4); target (0,12,-1); fov 62; amp 0.9; freq 0.08; handheld 0.015 }; show nddream { renderScale 0.75 }; post preset nd_dream }
    at 41.75 { anim newWorldDawn camera.pos cubic { 0 (0,5,-4); 10 (3,7,-1); 20 (5,10,5) } }
    at 41.75 { anim newWorldDawnTgt camera.target cubic { 0 (7,11,0); 10 (10,13,3); 20 (12,16,9) } }
    at 41.75 { anim newWorldDawnFov camera.fov linear { 0 62; 20 48 } }
    // act 4: the music fades, the world dissolves to black (bars 178-185)
    at 63 { fade out 7 }
}

// ---------------------------------------------------------------------------
// The show: one activation per scene at bar boundaries (128 BPM, bar = 1.875s)
// ---------------------------------------------------------------------------
at bar 0    { show Boot;      marker Boot }
at bar 13   { show Core;      marker Core }
at bar 29   { show Tunnel;    marker Tunnel }
at bar 45   { show City;      marker City }
at bar 63   { show Corrupt;   marker Corruption }
at bar 79   { show Dream;     marker Dream }
at bar 103  { show Ocean;     marker Ocean }
at bar 119  { show Failure;   marker SystemFailure }
at bar 135  { show Final;     marker FinalReconstruction }
at bar 145  { show NewReality; marker NewReality }
